# Documentation-only contract for Railway's staging service variables.
# Configure values in Railway and GitHub; do not copy secrets into this file.

# api service
AUTO_MIGRATE_DATABASE=false
CLERK_AUTHORIZED_PARTIES=https://trainspotting-staging.example.com
CLERK_SECRET_KEY=replace_in_railway
DATABASE_URL=replace_with_private_mysql_url

# web service (available during the Docker build)
VITE_CLERK_PUBLISHABLE_KEY=replace_in_railway

# web service (runtime private-network upstream; no scheme)
API_UPSTREAM=api.railway.internal:replace_with_api_port

# GitHub staging environment secrets used only by tagged-release automation
RAILWAY_TOKEN=replace_in_github
STAGING_BASE_URL=https://trainspotting-staging.example.com
STAGING_SMOKE_BEARER_TOKEN=replace_with_short_lived_member_token
